# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environment ───────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Django ────────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal

# Static / media (collected at deploy time)
staticfiles/
# media/ — keep if using local storage in dev, remove if using Cloudinary only
# media/

# ── Environment secrets ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.production          # real prod secrets — never commit (template: .env.production.example)

# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
.npm-cache/
.npm/

# Compiled Tailwind output — generated by `npm run css:build` (built on deploy)
static/css/tailwind.css

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ── IDE ───────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
celerybeat-schedule
celerybeat.pid
